# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
*~

# Node (in case you add tooling later)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python (if you add scripts)
__pycache__/
*.py[cod]
.venv/
venv/
